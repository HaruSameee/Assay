# Cloudflare R2 S3-compatible endpoint. Use the jurisdiction-specific endpoint
# when the bucket was created in the EU or US jurisdiction.
R2_ENDPOINT=
# Dedicated bucket for Assay backups.
R2_BUCKET=
# Object-key prefix. Keep a trailing slash, for example: assay/
R2_PREFIX=
# Cloudflare R2 S3 API credentials, scoped to R2_BUCKET only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 requires this value for S3-compatible clients.
AWS_REGION=auto
