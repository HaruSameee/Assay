# HTTP listener. Keep loopback-only behind Caddy.
HTTP_LISTEN_ADDR=
# tracing EnvFilter.
RUST_LOG=
# Leave empty to keep /internal/* unmounted.
INTERNAL_API_TOKEN=

# Discord bot and guild.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Number of vcN-red / vcN-blue pairs.
DISCORD_VC_POOL_SIZE=
# Match-room settings.
ROOM_MAP=
ROOM_CHECKLIST=
DISCORD_RETRIES=
DISCORD_RETRY_BACKOFF_MS=

# Discord OAuth2 identify-only application credentials.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# Signed-cookie settings.
SESSION_COOKIE_DOMAIN=
SESSION_SECRET=
SESSION_TTL_HOURS=
