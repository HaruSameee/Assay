# HTTP listener. Keep loopback-only behind Caddy.
HTTP_LISTEN_ADDR=
# tracing EnvFilter.
RUST_LOG=
# Leave empty to keep /internal/* unmounted.
INTERNAL_API_TOKEN=

# Discord bot and guild.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Staff-only dispute notifications and public match summons. These must differ.
DISCORD_DISPUTE_CHANNEL_ID=
DISCORD_SUMMON_CHANNEL_ID=
DISCORD_MATCHMAKER_LOG_CHANNEL_ID=
# Number of vcN-red / vcN-blue pairs.
DISCORD_VC_POOL_SIZE=
# Match-room settings.
ROOM_MAP=
ROOM_CHECKLIST=
DISCORD_RETRIES=
DISCORD_RETRY_BACKOFF_MS=

# Discord OAuth2 identify-only application credentials.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# Signed-cookie settings.
SESSION_COOKIE_DOMAIN=
SESSION_SECRET=
SESSION_TTL_HOURS=

# Admin rating-adjustment panel (/admin). Comma-separated Discord user ids.
# Unset or empty => the admin routes are not mounted at all (fail-closed).
ADMIN_DISCORD_USER_IDS=

# Address watch. Comma-separated Discord user ids whose sign-ins and queue joins
# are recorded with their connection headers (CF-Connecting-IP / X-Forwarded-For /
# User-Agent) and posted to DISCORD_DISPUTE_CHANNEL_ID. Nobody else is recorded.
# Unset or empty => nothing is recorded. Use it to identify the IP of an abusive
# account, then shadow-ban that IP from /admin/ip-bans.
IP_WATCH_DISCORD_USER_IDS=
