  "query": "select snapshot.player_id, snapshot.display_name, target.trainer_name from ( select distinct on (player_id) player_id, display_name from player_discord_snapshots order by player_id, id desc ) snapshot join players target on target.id = snapshot.player_id where snapshot.player_id <> $1 and position(lower($2) in lower(snapshot.display_name)) > 0 order by snapshot.display_name, snapshot.player_id limit 20",
