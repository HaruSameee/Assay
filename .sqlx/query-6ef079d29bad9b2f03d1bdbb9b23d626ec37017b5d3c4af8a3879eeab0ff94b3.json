  "db_name": "PostgreSQL",
  "query": "select c.id, c.amount, c.starts_at, c.ends_at, c.reason, c.created_by, c.created_at, r.created_at as \"revoked_at?\", ( select count(*) from formation_final_outcomes o join formations f on f.id = o.formation_id cross join current_season s where o.kind = 'confirmed' and f.created_at >= s.started_at and f.created_at >= c.starts_at and (c.ends_at is null or f.created_at < c.ends_at) ) as \"matches_in_period!\" from rating_delta_corrections c left join rating_delta_correction_revocations r on r.correction_id = c.id order by c.id desc limit 50",
