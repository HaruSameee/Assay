  "query": "select fp.player_id, fp.team, p.trainer_name from formation_players fp join players p on p.id = fp.player_id where fp.formation_id = $1 and not exists ( select 1 from match_reports mr where mr.formation_id = fp.formation_id and mr.player_id = fp.player_id ) order by fp.team, fp.player_id",
