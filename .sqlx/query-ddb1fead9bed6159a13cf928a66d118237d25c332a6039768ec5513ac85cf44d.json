{
  "db_name": "PostgreSQL",
  "query": "select q.id, q.player_id, q.down_range, q.enqueued_at, q.unmatched_scans, v.rating as \"rating!\", v.sigma as \"sigma!\", latest.formation_id as \"latest_formation?\", latest.created_at as \"latest_matched_at?\", latest.role_was_flexed as \"latest_role_was_flexed?\", coalesce(( select sum(g.bonus_seconds)::bigint from queue_priority_grants g where g.player_id = q.player_id and g.created_at > coalesce(latest.created_at, '-infinity'::timestamptz) ), 0) as \"priority_bonus_seconds!\" from queue_entries q join player_current_ratings v on v.player_id = q.player_id left join lateral ( select fp.formation_id, f.created_at, fp.role_was_flexed from formation_players fp join formations f on f.id = fp.formation_id where fp.player_id = q.player_id order by f.created_at desc, f.id desc limit 1 ) latest on true where not q.shadow_banned order by q.enqueued_at, q.id",
