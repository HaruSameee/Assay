  "query": "select a.id, a.kind, a.actor_discord_user_id, a.target_player_id, a.reason, a.occurred_at, case when a.kind = 'block_allowance_set' then (a.payload->>'allowance')::int end as \"allowance?\", p.trainer_name as \"trainer_name?\" from admin_actions a left join players p on p.id = a.target_player_id order by a.id desc limit $1",
