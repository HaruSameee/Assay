  "query": "select p.id, p.discord_user_id, p.trainer_name, p.status, p.registered_at, d.declared_at as \"declared_at?\", d.rank as \"rank?\", d.rating as \"rating?\" from players p left join lateral ( select declared_at, rank, rating from player_declarations where player_id = p.id order by id desc limit 1 ) d on true where p.id = $1",
