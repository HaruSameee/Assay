  "query": "select q.id as entry_id, q.player_id, q.enqueued_at, q.down_range, q.shadow_banned, q.unmatched_scans, p.discord_user_id, p.trainer_name, v.rating as \"rating!\", coalesce(( select sum(g.bonus_seconds)::bigint from queue_priority_grants g where g.player_id = q.player_id and g.created_at > coalesce(( select max(f.created_at) from formation_players fp join formations f on f.id = fp.formation_id where fp.player_id = q.player_id ), '-infinity'::timestamptz) ), 0) as \"priority_bonus_seconds!\" from queue_entries q join players p on p.id = q.player_id join player_current_ratings v on v.player_id = q.player_id order by q.enqueued_at, q.id",
