  "query": "insert into queue_entries (id, player_id, enqueued_at, updated_at, down_range, streaming) values ($1, $2, $3, $3, (select down_range from current_matching_ranges), $4) on conflict (player_id) do update set down_range = excluded.down_range, updated_at = excluded.updated_at, streaming = excluded.streaming returning id, enqueued_at, updated_at, down_range, (select up_range from current_matching_ranges) as \"up_range!\"",
