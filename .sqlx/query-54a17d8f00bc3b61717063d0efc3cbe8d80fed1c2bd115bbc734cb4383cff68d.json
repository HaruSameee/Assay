{
  "db_name": "PostgreSQL",
  "query": "select q.id, q.formation_id, q.reported_at, q.reporter_id, reporter.trainer_name as reporter_name, q.target_id, target.trainer_name as target_name, case when c.outcome in ('red', 'blue') then c.outcome = fp.team else null end as \"reporter_won?\", exists ( select 1 from quiet_report_penalties p where p.formation_id = q.formation_id and p.player_id = q.target_id ) as \"penalised!\" from quiet_reports q join players reporter on reporter.id = q.reporter_id join players target on target.id = q.target_id join formation_players fp on fp.formation_id = q.formation_id and fp.player_id = q.reporter_id left join lateral ( select e.payload->>'outcome' as outcome from formation_events e where e.formation_id = q.formation_id and e.kind = 'confirmed' order by e.id desc limit 1 ) c on true order by q.id desc limit $1",
