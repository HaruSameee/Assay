  "query": "select r.formation_id, r.target_id as \"target_id!\", p.trainer_name, count(*) as \"votes!\", exists (select 1 from nullified_report_penalties n where n.formation_id = r.formation_id and n.player_id = r.target_id) as \"penalised!\", exists (select 1 from formation_events e where e.formation_id = r.formation_id and e.kind = 'nullified') as \"match_nullified!\" from nullified_reports r join players p on p.id = r.target_id where r.target_id is not null group by r.formation_id, r.target_id, p.trainer_name order by count(*) desc, r.formation_id limit $1",
