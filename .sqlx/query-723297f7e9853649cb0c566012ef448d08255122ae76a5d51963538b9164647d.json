  "db_name": "PostgreSQL",
  "query": "select q.id as entry_id, q.player_id, q.enqueued_at, q.down_range, p.discord_user_id, p.trainer_name, $1::double precision + coalesce((select sum(a.delta_mu) from season_rating_adjustments a where a.player_id = q.player_id), 0::double precision) + coalesce(m.delta, 0::double precision) as \"rating!\" from queue_entries q join players p on p.id = q.player_id left join player_match_ratings m on m.player_id = q.player_id order by q.enqueued_at, q.id",
