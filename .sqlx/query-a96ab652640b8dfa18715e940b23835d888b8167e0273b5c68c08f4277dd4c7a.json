{
  "db_name": "PostgreSQL",
  "query": "select q.id, q.player_id, q.down_range, q.enqueued_at, $1::double precision + coalesce((select sum(a.delta_mu) from season_rating_adjustments a where a.player_id = q.player_id), 0::double precision) + coalesce(m.delta, 0::double precision) as \"rating!\", $2::double precision + coalesce((select sum(a.delta_sigma) from season_rating_adjustments a where a.player_id = q.player_id), 0::double precision) as \"sigma!\", latest.formation_id as \"latest_formation?\", latest.created_at as \"latest_matched_at?\", latest.role_was_flexed as \"latest_role_was_flexed?\" from queue_entries q left join player_match_ratings m on m.player_id = q.player_id left join lateral ( select fp.formation_id, f.created_at, fp.role_was_flexed from formation_players fp join formations f on f.id = fp.formation_id where fp.player_id = q.player_id order by f.created_at desc, f.id desc limit 1 ) latest on true order by q.enqueued_at, q.id",
