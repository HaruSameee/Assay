  "db_name": "PostgreSQL",
  "query": "select fp.player_id, fp.team, p.trainer_name, mr.outcome as \"outcome?\", (mr.raw_result->>'source' = 'staff') as \"from_staff?\" from formation_players fp join players p on p.id = fp.player_id left join match_reports mr on mr.formation_id = fp.formation_id and mr.player_id = fp.player_id and not exists ( select 1 from match_reports correction where correction.supersedes_id = mr.id ) where fp.formation_id = $1 order by fp.team, fp.player_id",
