  "query": "select r.id, r.formation_id, r.created_at, r.reporter_id, reporter.trainer_name as reporter_name, r.target_id, target.trainer_name as target_name, case when r.target_id is null then null else (select rfp.team <> tfp.team from formation_players rfp, formation_players tfp where rfp.formation_id = r.formation_id and rfp.player_id = r.reporter_id and tfp.formation_id = r.formation_id and tfp.player_id = r.target_id) end as \"cross_team?\" from nullified_reports r join players reporter on reporter.id = r.reporter_id left join players target on target.id = r.target_id order by r.id desc limit $1",
