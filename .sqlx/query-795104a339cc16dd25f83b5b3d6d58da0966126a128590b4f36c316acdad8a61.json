  "query": "select d.formation_id as \"formation_id!\", d.team as \"team!\", d.outcome as \"outcome!\", d.own_rating as \"own_rating!\", d.delta as \"delta!\", f.created_at as \"played_at!\", coalesce(q.delta, 0::double precision) as \"penalty!\" from player_match_rating_deltas d join formations f on f.id = d.formation_id left join quiet_report_penalties q on q.formation_id = d.formation_id and q.player_id = d.player_id where d.player_id = $1 order by f.created_at desc, d.formation_id desc limit $2",
