{
  "db_name": "PostgreSQL",
  "query": "select p.id, p.discord_user_id, p.trainer_name, p.status, p.registered_at, v.rating as \"rating!\", v.matches as \"matches!\", (select s.display_name from player_discord_snapshots s where s.player_id = p.id order by s.id desc limit 1) as display_name, exists (select 1 from queue_entries q where q.player_id = p.id) as \"queued!\" from players p join player_current_ratings v on v.player_id = p.id where $1::text is null or p.trainer_name ilike '%' || $1 || '%' or p.discord_user_id::text = $1 or exists ( select 1 from player_discord_snapshots s where s.player_id = p.id and s.display_name ilike '%' || $1 || '%' ) order by p.registered_at desc nulls last, p.created_at desc, p.id limit $2 offset $3",
