{
  "db_name": "PostgreSQL",
  "query": "select q.player_id, q.down_range, (select r.role from queue_entry_roles r where r.entry_id = q.id and r.priority = 1) as first_choice, $1::double precision + coalesce((select sum(a.delta_mu) from season_rating_adjustments a where a.player_id = q.player_id), 0::double precision) + coalesce(m.delta, 0::double precision) as \"rating!\" from queue_entries q left join player_match_ratings m on m.player_id = q.player_id",
