  "db_name": "PostgreSQL",
  "query": "select fp.player_id, fp.team, p.trainer_name, p.discord_user_id, (select s.display_name from player_discord_snapshots s where s.player_id = fp.player_id order by s.id desc limit 1) as discord_name, (select s.avatar_hash from player_discord_snapshots s where s.player_id = fp.player_id order by s.id desc limit 1) as avatar_hash, r.display_name as \"role_display_name!\", r.sort_order as \"role_sort_order!\", v.rating as \"rating!\" from formation_players fp join players p on p.id = fp.player_id join roles r on r.id = fp.role join player_current_ratings v on v.player_id = fp.player_id where fp.formation_id = $1 order by fp.team, r.sort_order, fp.player_id",
