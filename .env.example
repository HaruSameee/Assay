# PostgreSQL（アプリと同一ホスト前提。TLS なし。詳細は Cargo.toml の sqlx の項）
DATABASE_URL=postgres://assay_app:<app-password>@127.0.0.1:5432/assay

# HTTP API の待ち受け（省略時 127.0.0.1:8080）
HTTP_LISTEN_ADDR=127.0.0.1:8080

# ログレベル（tracing の EnvFilter。省略時 info）
RUST_LOG=info,unite_matchsystem=debug

# /internal/formations（手動テストの入口）の Bearer トークン。未設定なら内部エンドポイントはマウントされない（404）。
# 公開前（9/12）のチェックリスト: 本番ではこれを設定しない、またはリバースプロキシで /internal/ を外から遮断する。
INTERNAL_API_TOKEN=

# ---- Discord アダプタ（Phase 4）----
# Bot トークン。必要なインテントは GUILDS だけ（MESSAGE_CONTENT は不要）。
DISCORD_TOKEN=
# 対象ギルド。別ギルドからのインタラクションは無視する。
DISCORD_GUILD_ID=
# disputed の参加者・報告内訳を投稿する運営専用チャンネル ID。
DISCORD_DISPUTE_CHANNEL_ID=
# VC の組の個数。起動時に vc1-red / vc1-blue … vc<N>-red / vc<N>-blue をギルドのチャンネル一覧から名前で引く。
# 1 本でも無い、または同名が 2 本以上あれば起動しない。解決結果（名前 → ID）は起動ログに出る。
# Bot はこれらの VC を読んでテキストチャットに投稿するだけ（作成・削除・権限変更・メッセージ削除はしない）。
DISCORD_VC_POOL_SIZE=20
# 今シーズンのマップ（ランクマのローテで変わる唯一の項目）。チェックリストの先頭に「マップ: <値>」として入る。
ROOM_MAP=kyogre
# 部屋設定のチェックリスト（マップ以外の固定項目）。; 区切り。割り当て表の下に「- [ ] 項目」として並ぶ。
ROOM_CHECKLIST=項目1;項目2;項目3
# Discord API 呼び出しのリトライ回数 N（省略時 3）。超えたら abandoned（discord_call_failed）
DISCORD_RETRIES=3
# Discord API 呼び出しのリトライ間隔の基準（ミリ秒、省略時 1000。試行回数に比例して延びる）
DISCORD_RETRY_BACKOFF_MS=1000

# ---- 登録・認証トラック（05-登録トラック仕様）----
# Discord OAuth2 のアプリケーション資格情報。Developer Portal の「OAuth2」から取る。
# scope は identify だけを要求する（email も guilds も要求しない）。
DISCORD_CLIENT_ID=
# client_secret はログにもエラーにもレスポンスにも出さない。ファイルの権限に注意（root 所有 0600）。
DISCORD_CLIENT_SECRET=
# リダイレクト URI。Developer Portal の登録と**完全一致**させること（末尾スラッシュも含む）。
# https を要求する（開発時の loopback だけ http を許す）。
OAUTH_REDIRECT_URI=https://match.aynm.dev/auth/callback
# セッション Cookie の Domain。**ホストそのもの**を入れる。
# 先頭ドット（.aynm.dev）は起動時に拒否する: 親ドメインにすると個人サイトと Cookie を共有する。
SESSION_COOKIE_DOMAIN=match.aynm.dev
# セッション Cookie の署名鍵。64 バイト以上のランダム文字列。
# 生成例: openssl rand -base64 64 | tr -d '\n'
# 変えると全員のセッションが無効になる（再ログインで復帰する）。
SESSION_SECRET=
# セッションの有効期限（時間、省略時 336 = 14 日）。過ぎたら再ログインに落とす。
SESSION_TTL_HOURS=336

# true のとき報告ゲートだけを無効化する縮退用フラグ。登録ゲートは常に有効。既定 false。
REPORT_GATE_DISABLED=false
