# PostgreSQL（アプリと同一ホスト前提。TLS なし。詳細は Cargo.toml の sqlx の項）
DATABASE_URL=postgres://unite:unite_dev@localhost:5432/unite_matchsystem

# HTTP API の待ち受け（省略時 127.0.0.1:8080）
HTTP_LISTEN_ADDR=127.0.0.1:8080

# ログレベル（tracing の EnvFilter。省略時 info）
RUST_LOG=info,unite_matchsystem=debug

# /internal/formations（手動テストの入口）の Bearer トークン。未設定なら内部エンドポイントはマウントされない（404）。
# 公開前（9/12）のチェックリスト: 本番ではこれを設定しない、またはリバースプロキシで /internal/ を外から遮断する。
INTERNAL_API_TOKEN=

# ---- Discord アダプタ（Phase 4）----
# Bot トークン。必要なインテントは GUILDS だけ（MESSAGE_CONTENT は不要）。
DISCORD_TOKEN=
# 対象ギルド。別ギルドからのインタラクションは無視する。
DISCORD_GUILD_ID=
# VC の組の個数。起動時に vc1-red / vc1-blue … vc<N>-red / vc<N>-blue をギルドのチャンネル一覧から名前で引く。
# 1 本でも無い、または同名が 2 本以上あれば起動しない。解決結果（名前 → ID）は起動ログに出る。
# Bot はこれらの VC を読んでテキストチャットに投稿するだけ（作成・削除・権限変更・メッセージ削除はしない）。
DISCORD_VC_POOL_SIZE=10
# 今シーズンのマップ（ランクマのローテで変わる唯一の項目）。チェックリストの先頭に「マップ: <値>」として入る。
ROOM_MAP=kyogre
# 部屋設定のチェックリスト（マップ以外の固定項目）。; 区切り。割り当て表の下に「- [ ] 項目」として並ぶ。
ROOM_CHECKLIST=項目1;項目2;項目3
# Discord API 呼び出しのリトライ回数 N（省略時 3）。超えたら abandoned（discord_call_failed）
DISCORD_RETRIES=3
# Discord API 呼び出しのリトライ間隔の基準（ミリ秒、省略時 1000。試行回数に比例して延びる）
DISCORD_RETRY_BACKOFF_MS=1000
